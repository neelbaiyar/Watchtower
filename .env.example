# SEC asks automated clients to identify their application and a monitored contact.
WATCHTOWER_SEC_USER_AGENT="Watchtower local demo Your Name your-email@example.com"

# Create a free API token at https://www.marketaux.com/.
WATCHTOWER_MARKETAUX_API_TOKEN="replace-with-your-marketaux-token"

# Optional local Go poller configuration. The password must match the local
# PostgreSQL value in infra/postgres/.env; do not commit your real URL.
WATCHTOWER_POLLER_DATABASE_URL="postgres://watchtower:replace-with-your-local-password@127.0.0.1:5432/watchtower?sslmode=disable"
WATCHTOWER_POLLER_CIKS="replace-with-one-or-more-ten-digit-sec-ciks"

# Optional durable snapshot cache for the local dashboard/API. Use the same
# local PostgreSQL instance as the poller if desired, but keep this value out
# of Git. Without it, Watchtower still works through live provider calls.
WATCHTOWER_SNAPSHOT_DATABASE_URL="postgres://watchtower:replace-with-your-local-password@127.0.0.1:5432/watchtower?sslmode=disable"
WATCHTOWER_SNAPSHOT_CACHE_TTL_SECONDS="300"
